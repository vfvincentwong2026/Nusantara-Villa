# ============================================================
# Nusantara Villa - 环境变量配置示例
# 复制此文件为 .env.local 并填入真实值
# ============================================================

# ---------- 站点配置 ----------
# 站点 URL（用于 Telegram 消息中的链接）
NEXT_PUBLIC_SITE_URL=https://nusantara-villa.com

# ---------- Telegram 通知配置 ----------
# Telegram Bot Token（从 @BotFather 获取）
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Chat ID（群组或频道 ID）
TELEGRAM_CHAT_ID=your_chat_id_here

# ---------- WhatsApp 配置（可选）----------
# 官方 WhatsApp 号码（用于客户联系官方）
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
